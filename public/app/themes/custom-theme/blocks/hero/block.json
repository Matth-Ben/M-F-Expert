{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpg/hero",
	"version": "1.0.0",
	"title": "Hero",
	"category": "wpg",
	"icon": "cover-image",
	"description": "Grand visuel d'en-tête avec titre, texte et boutons.",
	"keywords": ["header", "banner", "bannière", "en-tête"],
	"textdomain": "wp-gutenberg",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"mediaId": { "type": "number" },
		"parallax": { "type": "boolean", "default": true },
		"animateTitle": { "type": "boolean", "default": true },
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"html": false,
		"align": ["full"],
		"anchor": true
	},
	"example": {
		"attributes": {
			"title": "Un titre qui claque",
			"text": "Un sous-titre pour poser le contexte."
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
