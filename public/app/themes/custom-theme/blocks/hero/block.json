{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpg/hero",
	"version": "2.0.0",
	"title": "Hero",
	"category": "wpg",
	"icon": "cover-image",
	"description": "En-tête de page, toujours en haut. Accueil : logo-texte, signature, boutons et grand logo. Page intérieure : fil d'Ariane, titre (titre de la page par défaut), filet et texte d'introduction.",
	"keywords": [
		"header",
		"banner",
		"bannière",
		"en-tête",
		"fil d'Ariane"
	],
	"textdomain": "wp-gutenberg",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [
				"page",
				"home"
			],
			"default": "page"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": "Espace anti-poux"
		},
		"signature": {
			"type": "string",
			"default": "La solution en toute confiance"
		},
		"align": {
			"type": "string",
			"default": "full"
		},
		"lock": {
			"type": "object",
			"default": {
				"move": true,
				"remove": true
			}
		}
	},
	"supports": {
		"html": false,
		"align": [
			"full"
		],
		"anchor": true,
		"multiple": false,
		"inserter": false,
		"reusable": false
	},
	"example": {
		"attributes": {
			"title": "Nos prestations",
			"text": "Texte d'introduction de la page, en une ou deux phrases."
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
