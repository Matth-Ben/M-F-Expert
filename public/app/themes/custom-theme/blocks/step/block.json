	"name": "wpg/step",
	"version": "1.0.0",
	"title": "Étape",
	"category": "wpg",
	"icon": "marker",
	"description": "Une étape numérotée automatiquement (dans un bloc Méthode en étapes).",
	"textdomain": "wp-gutenberg",
