{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpg/text-media",
	"version": "2.0.0",
	"title": "Texte + image",
	"category": "wpg",
	"icon": "align-pull-left",
	"description": "Présentation avec photo encadrée : surtitre, grand titre, textes, signature manuscrite et bouton. Photo à gauche ou à droite (au-dessus du texte sur mobile).",
	"keywords": ["media", "image", "texte", "bienvenue", "présentation"],
	"textdomain": "wp-gutenberg",
	"attributes": {
		"mediaId": { "type": "number" },
		"mediaPosition": { "type": "string", "enum": ["left", "right"], "default": "left" },
		"eyebrow": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"align": { "type": "string", "default": "full" }
	},
	"supports": {
		"html": false,
		"align": ["full"],
		"anchor": true,
		"color": { "background": true, "text": true, "link": false }
	},
	"example": {
		"attributes": {
			"eyebrow": "Bienvenue chez",
			"title": "M&amp;F Expert",
			"mediaPosition": "right"
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
