{
	"name": "wp-gutenberg",
	"version": "1.0.0",
	"description": "Starter WordPress theme — native Gutenberg blocks",
	"type": "module",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "concurrently -k -n vite,blocks -c blue,magenta \"vite\" \"pnpm blocks:dev\"",
		"build": "pnpm blocks:build && vite build",
		"blocks:dev": "wp-scripts start --webpack-src-dir=blocks --output-path=build --experimental-modules --blocks-manifest",
		"blocks:build": "wp-scripts build --webpack-src-dir=blocks --output-path=build --experimental-modules --blocks-manifest",
		"block:new": "node bin/create-block.mjs",
		"i18n": "pnpm build && wp i18n make-pot . languages/wp-gutenberg.pot --exclude=node_modules,dist,blocks,src && wp i18n update-po languages/wp-gutenberg.pot languages/fr_FR.po && wp i18n make-mo languages && wp i18n make-json languages --no-purge"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.13",
		"@wordpress/scripts": "^34.2.0",
		"concurrently": "^9.2.1",
		"laravel-vite-plugin": "^2.0.1",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"vite": "^7.1.7",
		"vite-plugin-compression": "^0.5.1",
		"vite-svg-sprite-wrapper": "^1.4.1"
	},
	"dependencies": {
		"@barba/core": "^2.10.3",
		"gsap": "^3.14.2",
		"lenis": "^1.3.17",
		"tailwindcss": "^4.1.13"
	}
}
