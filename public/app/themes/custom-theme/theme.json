{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "47.5rem",
			"wideSize": "77.5rem"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"gradients": [],
			"link": false,
			"palette": [
				{
					"slug": "bordeaux",
					"name": "Bordeaux",
					"color": "#763B48"
				},
				{
					"slug": "rose",
					"name": "Rose poudré",
					"color": "#A26864"
				},
				{
					"slug": "beige",
					"name": "Beige",
					"color": "#EBE2D8"
				},
				{
					"slug": "cream",
					"name": "Crème",
					"color": "#F7F1EA"
				},
				{
					"slug": "white",
					"name": "Blanc",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#3B1F27"
				},
				{
					"slug": "ink-soft",
					"name": "Encre douce",
					"color": "#4A2A32"
				},
				{
					"slug": "accent",
					"name": "Accroche",
					"color": "#8E5560"
				},
				{
					"slug": "gold",
					"name": "Or",
					"color": "#C38B47"
				},
				{
					"slug": "gold-dark",
					"name": "Or foncé",
					"color": "#8A5A1F"
				},
				{
					"slug": "gold-light",
					"name": "Or clair",
					"color": "#E8C28F"
				},
				{
					"slug": "gold-pale",
					"name": "Or très clair",
					"color": "#F2D3A4"
				},
				{
					"slug": "olive",
					"name": "Olive",
					"color": "#857F5F"
				},
				{
					"slug": "olive-dark",
					"name": "Olive foncé",
					"color": "#5E5A40"
				},
				{
					"slug": "field",
					"name": "Bord de champ",
					"color": "#967D5F"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontSizes": [],
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"rem",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "sm",
					"name": "S",
					"size": "clamp(2rem, 4vw, 3.5rem)"
				},
				{
					"slug": "md",
					"name": "M",
					"size": "clamp(3.5rem, 2.495rem + 4.124vw, 6rem)"
				},
				{
					"slug": "lg",
					"name": "L",
					"size": "clamp(4rem, 2.844rem + 4.742vw, 6.875rem)"
				}
			],
			"padding": false,
			"margin": false,
			"blockGap": false
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			},
			"core/image": {
				"lightbox": {
					"allowEditing": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--beige)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "1.25rem",
				"right": "1.25rem"
			}
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	}
}
